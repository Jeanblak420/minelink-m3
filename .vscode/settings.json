  // --- C/C++ analysis (Flutter Windows runner) ---
  // The native runner is built with MSVC via CMake (`flutter build windows`).
  // Point IntelliSense at the real MSVC compiler + Flutter's generated headers
  // so it stops emitting false "file not found" / STL-misparse errors.
  // clangd is disabled so it doesn't double-report against cpptools.
  "clangd.enable": false,
  "C_Cpp.intelliSenseEngine": "default",
  "C_Cpp.default.compilerPath": "C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/VC/Tools/MSVC/14.44.35207/bin/Hostx64/x64/cl.exe",
  "C_Cpp.default.intelliSenseMode": "windows-msvc-x64",
  "C_Cpp.default.cStandard": "c17",
  "C_Cpp.default.cppStandard": "c++17",
