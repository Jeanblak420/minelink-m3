{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Mine-Link portal: localhost (PHP + SQLite)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/public_html_portal/run_local.ps1\"",
            "options": {
                "cwd": "${workspaceFolder}/public_html_portal"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
