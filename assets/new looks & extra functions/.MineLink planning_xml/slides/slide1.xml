<p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr>
<p:sp><p:nvSpPr><p:cNvPr id="9" name="TextBox 8"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{288E6CD0-D873-4668-51BB-4010B941838B}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="707923" y="61305"/><a:ext cx="9910915" cy="6555641"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr>
<p:txBody><a:bodyPr wrap="square"><a:spAutoFit/></a:bodyPr><a:lstStyle/>
  <a:p><a:pPr algn="ctr"/><a:r><a:rPr lang="en-US" sz="2000" dirty="0"><a:highlight><a:srgbClr val="00FFFF"/></a:highlight></a:rPr><a:t>Phase 1 – flow diagram and app screens </a:t></a:r></a:p>

  <a:p><a:r><a:rPr lang="en-US" sz="2000" dirty="0"/><a:t>1.Mine ------------------ 2.transporter ---------- 3.buyer --------   ------ us </a:t></a:r></a:p>

  <a:p><a:endParaRPr lang="en-US" sz="2000" dirty="0"/></a:p>

  <a:p><a:endParaRPr lang="en-US" sz="2000" dirty="0"/></a:p>

  <a:p><a:r><a:rPr lang="en-US" sz="2000" dirty="0"/><a:t>1.1Dashboard          2.1 dashboard              3.1dashboard                4 control panel</a:t></a:r></a:p>

  <a:p><a:endParaRPr lang="en-US" sz="2000" dirty="0"/></a:p>

  <a:p><a:endParaRPr lang="en-US" sz="2000" dirty="0"/></a:p>

  <a:p><a:r><a:rPr lang="en-US" sz="2000" dirty="0"/><a:t>1.2 Control                      2.2 driver</a:t></a:r></a:p>

  <a:p><a:endParaRPr lang="en-US" sz="2000" dirty="0"/></a:p>

  <a:p><a:endParaRPr lang="en-US" sz="2000" dirty="0"/></a:p>

  <a:p><a:r><a:rPr lang="en-US" sz="2000" dirty="0"/><a:t>1.3 Security </a:t></a:r></a:p>

  <a:p><a:endParaRPr lang="en-US" sz="2000" dirty="0"/></a:p>

  <a:p><a:r><a:rPr lang="en-US" sz="2000" dirty="0"/><a:t>   </a:t></a:r></a:p>

  <a:p><a:r><a:rPr lang="en-US" sz="2000" dirty="0"/><a:t>1.	Buyer or transporter or mine or “Super Global Admin &amp; Child” can upload 	spreadsheets / truck list </a:t></a:r></a:p>

  <a:p><a:r><a:rPr lang="en-US" sz="2000" dirty="0"/><a:t>2.	Driver heads to mine/ loading point (trip status = </a:t></a:r><a:r><a:rPr lang="en-US" sz="2000" dirty="0" err="1"/><a:t>otw</a:t></a:r><a:r><a:rPr lang="en-US" sz="2000" dirty="0"/><a:t> to loading point)</a:t></a:r></a:p>

  <a:p><a:r><a:rPr lang="en-US" sz="2000" dirty="0"/><a:t>3.	Truck arrives at mine (security search truck) (marks arrived)</a:t></a:r></a:p>

  <a:p><a:r><a:rPr lang="en-US" sz="2000" dirty="0"/><a:t>4.	Truck loads – control enters tons loaded – truck is marked as loaded </a:t></a:r></a:p>

  <a:p><a:r><a:rPr lang="en-US" sz="2000" dirty="0"/><a:t>5.	Truck leaves (security marks as left) (trip status = loaded </a:t></a:r><a:r><a:rPr lang="en-US" sz="2000" dirty="0" err="1"/><a:t>otw</a:t></a:r><a:r><a:rPr lang="en-US" sz="2000" dirty="0"/><a:t> to delivery) </a:t></a:r></a:p>

  <a:p><a:r><a:rPr lang="en-US" sz="2000" dirty="0"/><a:t>6.	Truck offloads at delivery (driver uploads POD) (trip status = delivered)</a:t></a:r></a:p>

  <a:p><a:r><a:rPr lang="en-US" sz="2000" dirty="0"/><a:t>7.	System updates recons (then process starts again) </a:t></a:r></a:p>
</p:txBody>
</p:sp>
